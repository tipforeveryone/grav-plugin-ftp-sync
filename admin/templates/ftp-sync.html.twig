{% extends 'partials/base.html.twig' %}

{% block titlebar %}
    <div class="button-bar">
        <a class="button" href="{{ base_url }}"><i class="fa fa-reply"></i> {{ "PLUGIN_ADMIN.BACK"|t }}</a>
    </div>
    <h1><i class="fa fa-fw fa-exchange"></i> Sync Pages &amp; Theme (FTP)</h1>
{% endblock %}

{% block content %}
<div id="ftp-sync-app" data-ajax-url="{{ current_url }}.json" data-nonce="{{ admin.getNonce() }}" data-is-local="{{ ftp_sync_is_local() ? '1' : '0' }}">

    <style>
        #ftp-sync-app { overflow: hidden; padding: 0 2rem 3rem 2rem; }
        #ftp-sync-app .notices { padding-left: 0; }

        #ftp-sync-app .sc-top {
            display: flex;
            align-items: flex-start;
            gap: 2rem;
            margin-bottom: 1.5rem;
        }
        #ftp-sync-app .sc-top-left {
            flex: 1 1 auto;
            min-width: 0;
        }
        #ftp-sync-app .sc-top-right {
            flex: 0 0 16rem;
        }
        #ftp-sync-app .sc-top-left .notices { margin: 0; }

        @media (max-width: 48rem) {
            #ftp-sync-app .sc-top { flex-direction: column; }
            #ftp-sync-app .sc-top-right { flex-basis: auto; width: 100%; }
            #ftp-sync-app .sc-toolbar { flex-direction: row; flex-wrap: wrap; }
            #ftp-sync-app .sc-toolbar .button { width: auto; }
        }

        #ftp-sync-app .sc-kinds {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin: 1rem 0 0;
            padding: 0;
        }
        #ftp-sync-app .sc-kinds-title {
            font-weight: 700;
            margin-bottom: 0.2rem;
        }
        #ftp-sync-app .sc-kind-row {
            display: flex;
            align-items: center;
            gap: 1rem;
            cursor: pointer;
            font-weight: normal;
            margin: 0;
        }
        #ftp-sync-app .sc-kind-row input[type="checkbox"] {
            margin: 0;
            flex: 0 0 auto;
        }
        #ftp-sync-app .sc-kind-name {
            flex: 0 0 6rem;
            font-weight: 600;
        }
        #ftp-sync-app .sc-kind-desc {
            color: #666;
            font-size: 0.9rem;
        }

        #ftp-sync-app .sc-toolbar {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: 0.6rem;
        }
        #ftp-sync-app .sc-toolbar .button {
            width: 100%;
            text-align: center;
        }

        #ftp-sync-app #sc-status:not(:empty) { margin-bottom: 1rem; }

        #ftp-sync-app .sc-hint {
            margin: -0.5rem 0 1rem;
            font-size: 0.85rem;
            color: #555;
        }

        #ftp-sync-app #sc-replace-sync {
            background: #c9544a;
            color: #fff;
            border-color: #a83a32;
        }
        #ftp-sync-app #sc-replace-sync:hover { background: #a83a32; }

        #ftp-sync-app #sc-full-deploy-mark-synced.sc-ready {
            background: #2c5;
            color: #fff;
            border-color: #229944;
        }
        #ftp-sync-app #sc-full-deploy-mark-synced.sc-ready:hover { background: #229944; }

        #ftp-sync-app #sc-progress { margin: 0 0 1rem; }
        #ftp-sync-app .sc-progress-track {
            width: 100%;
            height: 0.9rem;
            background: #e6e6e6;
            border-radius: 999px;
            overflow: hidden;
        }
        #ftp-sync-app .sc-progress-fill {
            height: 100%;
            width: 0%;
            background: #2c5;
            transition: width 0.2s ease;
        }
        #ftp-sync-app .sc-progress-label {
            margin-top: 0.35rem;
            font-size: 0.85rem;
            color: #555;
            text-align: center;
        }
        #ftp-sync-app #sc-cancel-compress {
            display: block;
            margin: 0.5rem auto 0;
        }

        #ftp-sync-app .sc-modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        #ftp-sync-app .sc-modal-box {
            background: #fff;
            border-radius: 6px;
            max-width: 32rem;
            width: 90%;
            padding: 1.5rem;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25);
        }
        #ftp-sync-app .sc-modal-title {
            font-weight: 700;
            color: #a83a32;
            margin-bottom: 0.8rem;
            font-size: 1.05rem;
        }
        #ftp-sync-app .sc-modal-desc {
            color: #444;
            font-size: 0.9rem;
            line-height: 1.5;
            margin: 0 0 0.8rem;
        }
        #ftp-sync-app .sc-modal-question {
            font-weight: 600;
            margin: 0 0 1.2rem;
        }
        #ftp-sync-app .sc-modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 0.75rem;
        }
        #ftp-sync-app #sc-confirm-yes {
            background: #c9544a;
            color: #fff;
            border-color: #a83a32;
        }
        #ftp-sync-app #sc-confirm-yes:hover { background: #a83a32; }

        #ftp-sync-app .sc-filters,
        #ftp-sync-app .sc-bulk {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 1.2rem;
            margin-bottom: 1rem;
            padding: 0.6rem 0.8rem;
            background: #f7f7f7;
            border: 1px solid #e6e6e6;
            border-radius: 4px;
        }
        #ftp-sync-app .sc-filter-item,
        #ftp-sync-app .sc-bulk-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            height: 2.4rem;
        }
        #ftp-sync-app .sc-filters select,
        #ftp-sync-app .sc-bulk select {
            height: 2.4rem;
            line-height: 2.4rem;
            margin: 0;
            box-sizing: border-box;
        }
        #ftp-sync-app .sc-filter-label,
        #ftp-sync-app .sc-bulk-label {
            display: inline-flex;
            align-items: center;
            height: 2.4rem;
            font-weight: 600;
            color: #555;
            white-space: nowrap;
        }
        #ftp-sync-app .sc-filters .button,
        #ftp-sync-app .sc-bulk .button {
            height: 2.4rem;
            box-sizing: border-box;
        }

        /*
         * The admin theme renders <table class="overview-list"> with flexbox
         * (tr { display:flex }, td/th { display:block; flex:1 }) — it is NOT
         * a real table layout, so CSS `width` on td/th has no effect. Use
         * `flex: 0 0 <rem>` (fixed, no grow) for the narrow columns, so the
         * File column (keeps the theme's default flex:1) stretches to fill
         * the remaining space.
         */
        #ftp-sync-app table.overview-list td.sc-col-checkbox,
        #ftp-sync-app table.overview-list th.sc-col-checkbox {
            flex: 0 0 1.6rem;
            padding-left: 0.4rem;
            padding-right: 0.4rem;
            text-align: center;
        }
        #ftp-sync-app table.overview-list td.sc-col-status,
        #ftp-sync-app table.overview-list th.sc-col-status {
            flex: 0 0 5rem;
            text-align: center;
        }
        #ftp-sync-app table.overview-list td.sc-col-action,
        #ftp-sync-app table.overview-list th.sc-col-action {
            flex: 0 0 11rem;
        }
        #ftp-sync-app table.overview-list td.sc-col-backup-meta,
        #ftp-sync-app table.overview-list th.sc-col-backup-meta {
            flex: 0 0 10rem;
            text-align: center;
        }
        #ftp-sync-app table.overview-list td.sc-col-backup-action,
        #ftp-sync-app table.overview-list th.sc-col-backup-action {
            flex: 0 0 3rem;
            text-align: center;
        }
        #ftp-sync-app table.overview-list td.sc-col-action {
            display: flex;
            align-items: center;
        }
        #ftp-sync-app table.overview-list td,
        #ftp-sync-app table.overview-list th {
            word-break: break-word;
            padding-top: 0.35rem;
            padding-bottom: 0.35rem;
        }
        #ftp-sync-app table.overview-list tbody tr:nth-child(even) {
            background: #f5f5f5;
        }
        #ftp-sync-app .sc-status-conflict { color: #d9534f; font-weight: 600; }
        #ftp-sync-app .sc-status-x { color: #2c5; font-weight: 700; }
        #ftp-sync-app .sc-status-newer { background: #e3f1fc; color: #1f6fb2; font-weight: 600; }
        #ftp-sync-app .sc-status-older { background: #fbe9d6; color: #c87f0a; font-weight: 600; }

        #ftp-sync-app .sc-backup-location {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
            padding: 0.5rem 0.8rem;
            background: #f7f7f7;
            border: 1px solid #e6e6e6;
            border-radius: 4px;
            font-size: 0.9rem;
            color: #555;
        }

        /* Shared style for every combobox on the page: action column + filters + bulk action above. */
        #ftp-sync-app select.sc-resolution,
        #ftp-sync-app .sc-filters select,
        #ftp-sync-app .sc-bulk select {
            margin: 0;
            box-sizing: border-box;
            padding: 0 0.6rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            background: #fff;
            cursor: pointer;
            transition: border-color 0.15s ease;
        }
        #ftp-sync-app select.sc-resolution:hover,
        #ftp-sync-app .sc-filters select:hover,
        #ftp-sync-app .sc-bulk select:hover {
            border-color: #999;
        }
        #ftp-sync-app select.sc-resolution:focus,
        #ftp-sync-app .sc-filters select:focus,
        #ftp-sync-app .sc-bulk select:focus {
            border-color: #4d90fe;
            outline: none;
            box-shadow: 0 0 0 2px rgba(77, 144, 254, 0.2);
        }
        #ftp-sync-app select.sc-resolution {
            width: 100%;
            height: 2.2rem;
            line-height: 2.2rem;
        }
    </style>

    {% if ftp_sync_is_enabled() %}
    <div class="sc-top">
        <div class="sc-top-left">
            <div class="notices">
                <p>Diff is based on <b>mtime + size</b> over FTP (no hashing). On the first run (no baseline yet),
                every file that differs between local &amp; hosting shows up as <b>"Conflict"</b> so you can resolve it
                manually once; from then on the plugin infers the sync direction automatically. Before overwriting or
                deleting any file, the previous version is automatically zipped into <code>user/data/ftp-sync/backups/</code>.</p>

                <div class="sc-kinds">
                    <div class="sc-kinds-title">Sync</div>
                    <label class="sc-kind-row">
                        <input type="checkbox" class="sc-kind" value="pages" checked>
                        <span class="sc-kind-name">Pages</span>
                        <span class="sc-kind-desc">user/pages (all page content)</span>
                    </label>
                    <label class="sc-kind-row">
                        <input type="checkbox" class="sc-kind" value="themes" checked>
                        <span class="sc-kind-name">Themes</span>
                        <span class="sc-kind-desc">The site's active theme (auto-detected, not configured manually)</span>
                    </label>
                    <label class="sc-kind-row">
                        <input type="checkbox" class="sc-kind" value="plugins" checked>
                        <span class="sc-kind-name">Plugins</span>
                        <span class="sc-kind-desc">Plugins listed in the config, or every plugin under user/plugins/ if that list is left empty</span>
                    </label>
                    <label class="sc-kind-row">
                        <input type="checkbox" class="sc-kind" value="config" checked>
                        <span class="sc-kind-name">Config</span>
                        <span class="sc-kind-desc">user/config (excluding sensitive files such as the FTP password)</span>
                    </label>
                    <label class="sc-kind-row">
                        <input type="checkbox" class="sc-kind" value="accounts" checked>
                        <span class="sc-kind-name">Accounts</span>
                        <span class="sc-kind-desc">user/accounts (Admin login accounts)</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="sc-top-right">
            <div class="sc-toolbar">
                <button type="button" class="button" id="sc-check-diff"><i class="fa fa-refresh"></i> Check differences</button>
                <button type="button" class="button primary" id="sc-sync-now" disabled>
                    <i class="fa fa-cloud-upload"></i> Sync now
                </button>
                <button type="button" class="button" id="sc-replace-sync"
                        title="Delete all files currently on Hosting (within the checked categories above), then upload everything from Local.">
                    <i class="fa fa-warning"></i> Replace local sync to hosting
                </button>
                <button type="button" class="button" id="sc-full-deploy"
                        title="Ignores the categories above — bundles the ENTIRE site (minus dev-only files) into one .zip in user/data/ftp-sync/. Deleting old files on hosting and uploading the zip are up to you.">
                    <i class="fa fa-rocket"></i> Compress full site
                </button>
                <button type="button" class="button" id="sc-full-deploy-mark-synced" style="display:none"
                        title="Click ONLY after you have manually uploaded and extracted this zip on Hosting. Resets the sync baseline so 'Check differences' won't flag files whose content is unchanged but got a new mtime from extraction.">
                    <i class="fa fa-check"></i> Mark as deployed
                </button>
                <button type="button" class="button" id="sc-show-backups">
                    <i class="fa fa-archive"></i> Show backups
                </button>
            </div>
        </div>
    </div>

    <div id="sc-progress" style="display:none">
        <div class="sc-progress-track"><div class="sc-progress-fill"></div></div>
        <div class="sc-progress-label"></div>
        <button type="button" class="button" id="sc-cancel-compress" style="display:none">
            <i class="fa fa-times"></i> Cancel compressing
        </button>
    </div>

    <div id="sc-backups" style="display:none">
        <div class="sc-backup-location">
            <span>Backup folder: <code>{{ ftp_sync_backup_path() }}</code> (relative to the project root)</span>
            <button type="button" class="button" id="sc-copy-backup-path" data-path="{{ ftp_sync_backup_path() }}">
                <i class="fa fa-clipboard"></i> Copy location
            </button>
        </div>
        <table id="sc-backups-table" class="overview-list">
            <thead>
                <tr>
                    <th>File name</th>
                    <th class="sc-col-backup-meta">Size</th>
                    <th class="sc-col-backup-meta">Created</th>
                    <th class="sc-col-backup-action"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div id="sc-local-warning" class="notices error" style="display:none">
        This does not look like a local environment (no .ddev/ folder found) — "Sync now" / "Replace local sync" / "Full deploy" are locked.
        Enable <code>force_allow_remote</code> in the plugin config if you really want to skip this check.
    </div>

    <div id="sc-status"></div>
    <div id="sc-full-deploy-hint" class="sc-hint" style="display:none">
        <i class="fa fa-info-circle"></i> Đã tự tay upload + giải nén file zip này lên Hosting? Bấm <b>"Mark as deployed"</b> để cập nhật lại trạng thái đồng bộ.
    </div>

    <div id="sc-confirm-modal" class="sc-modal-overlay" style="display:none">
        <div class="sc-modal-box">
            <div class="sc-modal-title"><i class="fa fa-exclamation-triangle"></i> <span id="sc-confirm-title">Confirm upload</span></div>
            <p class="sc-modal-desc" id="sc-confirm-desc"></p>
            <p class="sc-modal-question">Are you sure you want to continue?</p>
            <div class="sc-modal-actions">
                <button type="button" class="button" id="sc-confirm-yes">Yes, upload</button>
                <button type="button" class="button" id="sc-confirm-no">No</button>
            </div>
        </div>
    </div>

    <div id="sc-results" style="display:none">
        <div class="sc-filters">
            <div class="sc-filter-item">
                <span class="sc-filter-label">Category:</span>
                <select id="sc-filter-kind">
                    <option value="">All</option>
                    <option value="pages">Pages</option>
                    <option value="themes">Themes</option>
                    <option value="plugins">Plugins</option>
                    <option value="config">Config</option>
                    <option value="accounts">Accounts</option>
                </select>
            </div>
            <div class="sc-filter-item">
                <span class="sc-filter-label">Status:</span>
                <select id="sc-filter-status">
                    <option value="">All</option>
                    <option value="changed">Changed (size/mtime differ)</option>
                    <option value="local_only">Local only</option>
                    <option value="host_only">Hosting only</option>
                </select>
            </div>
            <button type="button" class="button" id="sc-filter-apply">Apply filter</button>
        </div>

        <div class="sc-bulk">
            <div class="sc-bulk-item">
                <span class="sc-bulk-label">Apply to selected rows:</span>
                <select id="sc-bulk-action">
                    <option value="local">Use Local version</option>
                    <option value="remote">Use Hosting version</option>
                    <option value="">No action</option>
                    <option value="delete_local">Delete on Local</option>
                    <option value="delete_remote">Delete on Hosting</option>
                </select>
            </div>
            <button type="button" class="button" id="sc-bulk-apply">Apply</button>
        </div>

        <table id="sc-diff-table" class="overview-list">
            <thead>
                <tr>
                    <th class="sc-col-checkbox"><input type="checkbox" id="sc-select-all"></th>
                    <th>File</th>
                    <th class="sc-col-status">Local</th>
                    <th class="sc-col-status">Host</th>
                    <th class="sc-col-action">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    {% else %}
    <div class="notices error">
        <p><i class="fa fa-exclamation-triangle"></i> <b>FTP Sync is disabled.</b>
        This does not look like a local development environment (no <code>.ddev/</code> folder found at the webroot),
        so every FTP Sync action — checking differences, syncing, uploading, and managing backups — is turned off here.
        This is intentional: FTP credentials should never be exercised from a live hosting deployment of this plugin.</p>
        <p>If this really is a local environment and the check is wrong, enable <code>force_allow_remote</code> in the plugin's config.</p>
    </div>
    {% endif %}
</div>

{% if ftp_sync_is_enabled() %}
<script>
(function () {
    var app = document.getElementById('ftp-sync-app');
    if (!app) { return; }

    var ajaxUrl = app.dataset.ajaxUrl;
    var nonce = app.dataset.nonce;
    var isLocal = app.dataset.isLocal === '1';

    var checkBtn = document.getElementById('sc-check-diff');
    var syncBtn = document.getElementById('sc-sync-now');
    var replaceBtn = document.getElementById('sc-replace-sync');
    var fullDeployBtn = document.getElementById('sc-full-deploy');
    var fullDeployMarkBtn = document.getElementById('sc-full-deploy-mark-synced');
    var fullDeployHint = document.getElementById('sc-full-deploy-hint');
    var statusEl = document.getElementById('sc-status');
    var results = document.getElementById('sc-results');
    var table = document.getElementById('sc-diff-table');
    var tbody = table.querySelector('tbody');
    var localWarning = document.getElementById('sc-local-warning');
    var kindCheckboxes = document.querySelectorAll('.sc-kind');
    var filterKind = document.getElementById('sc-filter-kind');
    var filterStatus = document.getElementById('sc-filter-status');
    var filterApplyBtn = document.getElementById('sc-filter-apply');
    var selectAll = document.getElementById('sc-select-all');
    var bulkAction = document.getElementById('sc-bulk-action');
    var bulkApplyBtn = document.getElementById('sc-bulk-apply');
    var showBackupsBtn = document.getElementById('sc-show-backups');
    var backupsBox = document.getElementById('sc-backups');
    var backupsTbody = document.querySelector('#sc-backups-table tbody');
    var progressBox = document.getElementById('sc-progress');
    var progressFill = progressBox.querySelector('.sc-progress-fill');
    var progressLabel = progressBox.querySelector('.sc-progress-label');
    var cancelCompressBtn = document.getElementById('sc-cancel-compress');

    if (!isLocal) {
        localWarning.style.display = '';
        replaceBtn.disabled = true;
        fullDeployBtn.disabled = true;
        fullDeployMarkBtn.disabled = true;
    }

    function showProgress(done, total, label) {
        progressBox.style.display = '';
        var pct = total > 0 ? Math.round((done / total) * 100) : 100;
        progressFill.style.width = pct + '%';
        progressLabel.textContent = label + ' (' + done + '/' + total + ')';
    }

    function hideProgress() {
        progressBox.style.display = 'none';
        progressFill.style.width = '0%';
        cancelCompressBtn.style.display = 'none';
    }

    var TYPE_LABELS = {
        missing_remote: 'Missing on Hosting',
        missing_local: 'Missing on Local',
        changed: 'Different — size or mtime differ'
    };

    // Default select value per type: missing_remote/missing_local default to
    // their natural direction (keeps the old automatic behavior if the user
    // leaves it alone); 'changed' defaults to the side with the newer mtime
    // when it's known, otherwise requires an explicit choice.
    var DEFAULT_RESOLUTION_BY_TYPE = {
        missing_remote: 'local',
        missing_local: 'remote',
        changed: ''
    };

    function defaultResolution(row) {
        if (row.type === 'changed') {
            if (row.newer === 'local') { return 'local'; }
            if (row.newer === 'remote') { return 'remote'; }
            return '';
        }
        return DEFAULT_RESOLUTION_BY_TYPE[row.type] || '';
    }

    var RESOLUTION_OPTIONS = [
        ['', 'No action'],
        ['local', 'Use Local version'],
        ['remote', 'Use Hosting version'],
        ['delete_local', 'Delete on Local'],
        ['delete_remote', 'Delete on Hosting']
    ];

    var lastRows = {};

    function setStatus(message, isError) {
        statusEl.textContent = message;
        statusEl.className = isError ? 'notices error' : 'notices';
    }

    function post(task, extraFields) {
        var fd = new FormData();
        fd.append('task', task);
        fd.append('admin-nonce', nonce);
        (extraFields || []).forEach(function (pair) {
            fd.append(pair[0], pair[1]);
        });

        return fetch(ajaxUrl, { method: 'POST', body: fd, credentials: 'same-origin' })
            .then(function (res) { return res.json(); });
    }

    /** "pages/x.md" -> 'pages'; "config/x.yaml" -> 'config'; "theme:foo/x.css" -> 'themes'; "plugin:foo/x.php" -> 'plugins' */
    function kindOfPath(path) {
        var prefix = path.split('/')[0];
        if (prefix === 'pages') { return 'pages'; }
        if (prefix === 'config') { return 'config'; }
        if (prefix === 'accounts') { return 'accounts'; }
        if (prefix.indexOf('theme:') === 0) { return 'themes'; }
        if (prefix.indexOf('plugin:') === 0) { return 'plugins'; }
        return '';
    }

    /** Collapses the internal types into the groups shown in the "Status" filter. */
    function statusGroup(type) {
        if (type === 'changed') { return 'changed'; }
        if (type === 'missing_remote') { return 'local_only'; }
        if (type === 'missing_local') { return 'host_only'; }
        return '';
    }

    /**
     * Local/Host columns. 'changed': the side with the newer mtime shows
     * "Newer" (light blue), the older side shows "Older"; if neither side
     * is newer (mtime tie, only size differs) both show "Diff" (red).
     * missing_remote/missing_local: "X" on whichever side currently HAS
     * the file (i.e. missing_remote = local has it, hosting doesn't -> X
     * on Local column).
     */
    function statusCells(row) {
        var empty = { text: '', cls: '' };
        var diffCell = { text: 'Diff', cls: 'sc-status-conflict' };
        var newerCell = { text: 'Newer', cls: 'sc-status-newer' };
        var olderCell = { text: 'Older', cls: 'sc-status-older' };
        var xCell = { text: 'X', cls: 'sc-status-x' };

        switch (row.type) {
            case 'changed':
                if (row.newer === 'local') { return [newerCell, olderCell]; }
                if (row.newer === 'remote') { return [olderCell, newerCell]; }
                return [diffCell, diffCell];
            case 'missing_remote':
                return [xCell, empty];
            case 'missing_local':
                return [empty, xCell];
            default:
                return [empty, empty];
        }
    }

    function buildResolutionSelect(path, row) {
        var select = document.createElement('select');
        select.dataset.path = path;
        select.className = 'sc-resolution';
        RESOLUTION_OPTIONS.forEach(function (opt) {
            var o = document.createElement('option');
            o.value = opt[0];
            o.textContent = opt[1];
            select.appendChild(o);
        });
        select.value = defaultResolution(row);
        return select;
    }

    function renderRows(rows) {
        lastRows = rows || {};
        tbody.innerHTML = '';
        var paths = Object.keys(lastRows);

        if (paths.length === 0) {
            results.style.display = 'none';
            setStatus('No differences — local and hosting are in sync.', false);
            return;
        }

        paths.sort();
        paths.forEach(function (path) {
            var type = lastRows[path].type;
            var cells = statusCells(lastRows[path]);

            var tr = document.createElement('tr');
            tr.dataset.path = path;
            tr.dataset.kind = kindOfPath(path);
            tr.dataset.type = type;
            tr.dataset.statusGroup = statusGroup(type);

            var tdCheck = document.createElement('td');
            tdCheck.className = 'sc-col-checkbox';
            var checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.className = 'sc-row-select';
            tdCheck.appendChild(checkbox);
            tr.appendChild(tdCheck);

            var tdPath = document.createElement('td');
            tdPath.textContent = path;
            tdPath.title = TYPE_LABELS[type] || type;
            tr.appendChild(tdPath);

            var tdLocal = document.createElement('td');
            tdLocal.className = 'sc-col-status' + (cells[0].cls ? ' ' + cells[0].cls : '');
            tdLocal.textContent = cells[0].text;
            tr.appendChild(tdLocal);

            var tdHost = document.createElement('td');
            tdHost.className = 'sc-col-status' + (cells[1].cls ? ' ' + cells[1].cls : '');
            tdHost.textContent = cells[1].text;
            tr.appendChild(tdHost);

            var tdAction = document.createElement('td');
            tdAction.className = 'sc-col-action';
            tdAction.appendChild(buildResolutionSelect(path, lastRows[path]));
            tr.appendChild(tdAction);

            tbody.appendChild(tr);
        });

        selectAll.checked = false;
        applyFilters();
        results.style.display = '';
        setStatus(paths.length + ' file(s) differ.', false);
    }

    function applyFilters() {
        var kind = filterKind.value;
        var status = filterStatus.value;

        tbody.querySelectorAll('tr').forEach(function (tr) {
            var matchKind = !kind || tr.dataset.kind === kind;
            var matchStatus = !status || tr.dataset.statusGroup === status;
            tr.style.display = (matchKind && matchStatus) ? '' : 'none';
        });
    }

    filterApplyBtn.addEventListener('click', applyFilters);

    selectAll.addEventListener('change', function () {
        tbody.querySelectorAll('tr').forEach(function (tr) {
            if (tr.style.display === 'none') { return; }
            var cb = tr.querySelector('.sc-row-select');
            if (cb) { cb.checked = selectAll.checked; }
        });
    });

    bulkApplyBtn.addEventListener('click', function () {
        var value = bulkAction.value;
        var count = 0;
        tbody.querySelectorAll('tr').forEach(function (tr) {
            var cb = tr.querySelector('.sc-row-select');
            if (!cb || !cb.checked) { return; }
            var select = tr.querySelector('select.sc-resolution');
            if (select) {
                select.value = value;
                count++;
            }
        });
        if (count === 0) {
            setStatus('No rows selected to apply the bulk action to.', true);
        } else {
            setStatus('Applied to ' + count + ' row(s).', false);
        }
    });

    function selectedKinds() {
        var kinds = [];
        kindCheckboxes.forEach(function (cb) {
            if (cb.checked) { kinds.push(cb.value); }
        });
        return kinds;
    }

    checkBtn.addEventListener('click', function () {
        var kinds = selectedKinds();
        if (kinds.length === 0) {
            setStatus('Select at least 1 category (Pages/Themes/Plugins/Config/Accounts) to check.', true);
            return;
        }

        setStatus('Checking...', false);
        syncBtn.disabled = true;
        var fields = kinds.map(function (kind) { return ['kinds[]', kind]; });
        post('ftpsynccheckdiff', fields).then(function (data) {
            if (data.status !== 'success') {
                setStatus('Error: ' + (data.message || 'unknown'), true);
                return;
            }
            renderRows(data.rows || {});
            syncBtn.disabled = !isLocal || Object.keys(data.rows || {}).length === 0;
        }).catch(function (e) {
            setStatus('Error: ' + e, true);
        });
    });

    /**
     * Chạy tuần tự nhiều batch nhỏ (mỗi lần gọi 1 request AJAX) cho tới khi
     * finished=true, cập nhật progress bar sau mỗi batch. `stepTask` nhận
     * job_id, trả về {done,total,finished,...}; `onDone` nhận response của
     * batch cuối cùng (finished=true).
     *
     * `cancelToken` (tuỳ chọn, dạng {cancelled:false, onCancelled:fn}) cho
     * phép huỷ giữa chừng: cờ `cancelled` chỉ được đọc SAU KHI request batch
     * hiện tại đã trả lời xong (không bao giờ huỷ 1 request đang bay), để
     * tránh đụng độ với server đang ghi file (VD zip của Full deploy).
     */
    function runBatchedJob(stepTask, jobId, label, onDone, onError, cancelToken) {
        post(stepTask, [['job_id', jobId]]).then(function (data) {
            if (cancelToken && cancelToken.cancelled) {
                cancelToken.onCancelled();
                return;
            }
            if (data.status !== 'success') {
                hideProgress();
                onError(data.message || 'unknown');
                return;
            }
            showProgress(data.done, data.total, label);
            if (data.finished) {
                hideProgress();
                onDone(data);
            } else {
                runBatchedJob(stepTask, jobId, label, onDone, onError, cancelToken);
            }
        }).catch(function (e) {
            if (cancelToken && cancelToken.cancelled) {
                cancelToken.onCancelled();
                return;
            }
            hideProgress();
            onError(String(e));
        });
    }

    syncBtn.addEventListener('click', function () {
        if (!window.confirm('Sync now? Files about to be overwritten will be backed up automatically first.')) {
            return;
        }

        var fields = [];
        tbody.querySelectorAll('select.sc-resolution').forEach(function (select) {
            if (select.value) {
                fields.push(['resolutions[' + select.dataset.path + ']', select.value]);
            }
        });

        setStatus('Starting sync...', false);
        syncBtn.disabled = true;
        post('ftpsyncsyncstart', fields).then(function (data) {
            if (data.status !== 'success') {
                setStatus('Error: ' + (data.message || 'unknown'), true);
                syncBtn.disabled = !isLocal;
                return;
            }
            if (data.total === 0) {
                setStatus('Nothing to sync (no rows had an action selected).', false);
                syncBtn.disabled = !isLocal;
                return;
            }
            showProgress(0, data.total, 'Syncing');
            runBatchedJob('ftpsyncsyncstep', data.job_id, 'Syncing', function (finalData) {
                var msg = 'Applied ' + finalData.applied + ' change(s), skipped ' + finalData.skipped + '.';
                if (finalData.backup) {
                    msg += ' Backup: ' + finalData.backup;
                }
                if (finalData.errors && Object.keys(finalData.errors).length > 0) {
                    msg += ' ' + Object.keys(finalData.errors).length + ' file(s) failed (see console).';
                    console.error('FTP Sync errors:', finalData.errors);
                }
                setStatus(msg, false);
                results.style.display = 'none';
                syncBtn.disabled = !isLocal;
            }, function (message) {
                setStatus('Error: ' + message, true);
                syncBtn.disabled = !isLocal;
            });
        }).catch(function (e) {
            setStatus('Error: ' + e, true);
            syncBtn.disabled = !isLocal;
        });
    });

    var FORCE_PUSH_CONFIRM_TOKEN = 'CONFIRMED';
    var confirmModal = document.getElementById('sc-confirm-modal');
    var confirmTitleEl = document.getElementById('sc-confirm-title');
    var confirmDescEl = document.getElementById('sc-confirm-desc');
    var confirmYesBtn = document.getElementById('sc-confirm-yes');
    var confirmNoBtn = document.getElementById('sc-confirm-no');

    var PUSH_MODES = {
        replace: {
            title: 'Confirm: replace local sync to hosting',
            desc: 'This will <b>DELETE ALL</b> files currently on Hosting (within the categories you have checked above), ' +
                'then upload everything from Local to replace them. Anything that only exists on Hosting (and not on Local) will be lost — ' +
                'the system will back up the Hosting copy before deleting, but you should still make sure Local is the correct version.',
            btn: replaceBtn,
            startTask: 'ftpsyncpushstart',
            stepTask: 'ftpsyncpushstep',
            needsKinds: true
        },
        full: {
            btn: fullDeployBtn,
            startTask: 'ftpsyncfulldeploystart',
            stepTask: 'ftpsyncfulldeploystep',
            needsKinds: false
        }
    };

    /** Token của job "Compress full site" đang chạy, để nút Cancel huỷ đúng job. null khi không có job nào đang nén. */
    var fullDeployCancelToken = null;

    /**
     * Full deploy giờ CHỈ nén site thành 1 file .zip local (không xoá,
     * không upload — người dùng tự làm 2 việc đó thủ công), nên không
     * cần xác nhận nguy hiểm và bỏ qua field 'confirm'.
     */
    function runFullDeploy() {
        var config = PUSH_MODES.full;

        setStatus('Compressing...', false);
        config.btn.disabled = true;
        fullDeployMarkBtn.style.display = 'none';
        fullDeployMarkBtn.classList.remove('sc-ready');
        fullDeployHint.style.display = 'none';
        post(config.startTask, []).then(function (data) {
            if (data.status !== 'success') {
                setStatus('Error: ' + (data.message || 'unknown'), true);
                config.btn.disabled = !isLocal;
                return;
            }
            if (data.total === 0) {
                setStatus('Nothing to compress.', false);
                config.btn.disabled = !isLocal;
                return;
            }

            var jobId = data.job_id;
            fullDeployCancelToken = {
                cancelled: false,
                onCancelled: function () {
                    hideProgress();
                    finishCancelFullDeploy(jobId);
                }
            };

            showProgress(0, data.total, 'Compressing');
            cancelCompressBtn.style.display = '';
            cancelCompressBtn.disabled = false;

            runBatchedJob(config.stepTask, jobId, 'Compressing', function (finalData) {
                fullDeployCancelToken = null;
                setStatus('Compressed ' + data.total + ' file(s) into "' + finalData.zip_file + '" — find it under user/data/ftp-sync/ and upload it to Hosting yourself.', false);
                config.btn.disabled = !isLocal;
                fullDeployMarkBtn.style.display = '';
                fullDeployMarkBtn.disabled = !isLocal;
                fullDeployMarkBtn.classList.add('sc-ready');
                fullDeployHint.style.display = '';
            }, function (message) {
                fullDeployCancelToken = null;
                setStatus('Error: ' + message, true);
                config.btn.disabled = !isLocal;
            }, fullDeployCancelToken);
        }).catch(function (e) {
            setStatus('Error: ' + e, true);
            config.btn.disabled = !isLocal;
        });
    }

    /** Yêu cầu huỷ job đang nén — chỉ đặt cờ, việc dọn dẹp thật diễn ra sau khi batch đang bay trả lời xong (xem runBatchedJob). */
    function requestCancelFullDeploy() {
        if (!fullDeployCancelToken || fullDeployCancelToken.cancelled) {
            return;
        }
        if (!window.confirm('Huỷ nén? File .zip đang nén dở sẽ bị xoá.')) {
            return;
        }
        fullDeployCancelToken.cancelled = true;
        cancelCompressBtn.disabled = true;
        setStatus('Cancelling...', false);
    }

    /** Dọn dẹp thật sự sau khi huỷ: gọi server xoá job + file .zip dở, rồi mở khoá lại nút Compress. */
    function finishCancelFullDeploy(jobId) {
        post('ftpsyncfulldeploycancel', [['job_id', jobId]]).then(function (data) {
            fullDeployBtn.disabled = !isLocal;
            if (data.status !== 'success') {
                setStatus('Error while cancelling: ' + (data.message || 'unknown'), true);
                return;
            }
            setStatus('Compression cancelled — the partial zip file was deleted.', false);
        }).catch(function (e) {
            fullDeployBtn.disabled = !isLocal;
            setStatus('Error while cancelling: ' + e, true);
        });
    }

    /**
     * Gọi SAU KHI người dùng đã tự tay upload + giải nén zip full-deploy
     * lên Hosting — kết nối FTP đọc mtime/size thật trên hosting rồi lưu
     * lại làm baseline, để "Check differences" lần sau không báo
     * push/pull/conflict giả do file bị đổi mtime lúc giải nén dù nội
     * dung không đổi.
     */
    function runFullDeployMarkSynced() {
        if (!window.confirm('Bạn đã tự tay upload VÀ giải nén file zip này lên Hosting chưa?\n\nThao tác này sẽ kết nối FTP để đọc mtime/size THẬT trên Hosting rồi lưu lại làm baseline (không upload/download gì) — chỉ bấm Yes khi chắc chắn đã deploy xong.')) {
            return;
        }

        fullDeployMarkBtn.disabled = true;
        setStatus('Reading current state from Hosting via FTP...', false);
        post('ftpsyncfulldeploymarksynced', []).then(function (data) {
            if (data.status !== 'success') {
                setStatus('Error: ' + (data.message || 'unknown'), true);
                fullDeployMarkBtn.disabled = !isLocal;
                return;
            }
            setStatus('Baseline updated for ' + data.files + ' file(s) across ' + data.groups + ' group(s) — "Check differences" will now treat Hosting as matching Local for these.', false);
            fullDeployMarkBtn.style.display = 'none';
            fullDeployMarkBtn.classList.remove('sc-ready');
            fullDeployHint.style.display = 'none';
        }).catch(function (e) {
            setStatus('Error: ' + e, true);
            fullDeployMarkBtn.disabled = !isLocal;
        });
    }

    function runPushJob(mode, kinds) {
        var config = PUSH_MODES[mode];
        var fields = config.needsKinds ? kinds.map(function (kind) { return ['kinds[]', kind]; }) : [];
        fields.push(['confirm', FORCE_PUSH_CONFIRM_TOKEN]);

        setStatus('Preparing file list...', false);
        config.btn.disabled = true;
        post(config.startTask, fields).then(function (data) {
            if (data.status !== 'success') {
                setStatus('Error: ' + (data.message || 'unknown'), true);
                config.btn.disabled = !isLocal;
                return;
            }
            if (data.total === 0) {
                setStatus('Nothing to upload.', false);
                config.btn.disabled = !isLocal;
                return;
            }

            showProgress(0, data.total, 'Uploading');
            runBatchedJob(config.stepTask, data.job_id, 'Uploading', function (finalData) {
                var msg = 'Deleted ' + finalData.deleted + ' old file(s) on Hosting and uploaded ' + finalData.uploaded + ' file(s) from Local' +
                    (finalData.groups ? ' (' + finalData.groups + ' categor' + (finalData.groups === 1 ? 'y' : 'ies') + ')' : '') + '.';
                if (finalData.backup) {
                    msg += ' Backup: ' + finalData.backup;
                }
                setStatus(msg, false);
                results.style.display = 'none';
                config.btn.disabled = !isLocal;
            }, function (message) {
                setStatus('Error: ' + message, true);
                config.btn.disabled = !isLocal;
            });
        }).catch(function (e) {
            setStatus('Error: ' + e, true);
            config.btn.disabled = !isLocal;
        });
    }

    function openConfirmModal(mode) {
        var kinds = [];
        if (PUSH_MODES[mode].needsKinds) {
            kinds = selectedKinds();
            if (kinds.length === 0) {
                setStatus('Select at least 1 category before uploading.', true);
                return;
            }
        }

        confirmModal.dataset.mode = mode;
        confirmModal.dataset.kinds = JSON.stringify(kinds);
        confirmTitleEl.textContent = PUSH_MODES[mode].title;
        confirmDescEl.innerHTML = PUSH_MODES[mode].desc;
        confirmModal.style.display = '';
    }

    replaceBtn.addEventListener('click', function () { openConfirmModal('replace'); });
    fullDeployBtn.addEventListener('click', runFullDeploy);
    fullDeployMarkBtn.addEventListener('click', runFullDeployMarkSynced);
    cancelCompressBtn.addEventListener('click', requestCancelFullDeploy);

    confirmNoBtn.addEventListener('click', function () {
        confirmModal.style.display = 'none';
        setStatus('Upload cancelled.', false);
    });

    confirmYesBtn.addEventListener('click', function () {
        var mode = confirmModal.dataset.mode;
        var kinds = JSON.parse(confirmModal.dataset.kinds || '[]');
        confirmModal.style.display = 'none';
        runPushJob(mode, kinds);
    });

    confirmModal.addEventListener('click', function (e) {
        if (e.target === confirmModal) {
            confirmModal.style.display = 'none';
            setStatus('Upload cancelled.', false);
        }
    });

    function formatSize(bytes) {
        if (bytes >= 1024 * 1024) { return (bytes / (1024 * 1024)).toFixed(1) + ' MB'; }
        if (bytes >= 1024) { return (bytes / 1024).toFixed(1) + ' KB'; }
        return bytes + ' B';
    }

    function formatDate(unixTime) {
        var d = new Date(unixTime * 1000);
        function pad(n) { return n < 10 ? '0' + n : '' + n; }
        return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' +
            pad(d.getHours()) + ':' + pad(d.getMinutes());
    }

    function renderBackups(backups) {
        backupsTbody.innerHTML = '';
        if (!backups || backups.length === 0) {
            backupsBox.style.display = 'none';
            setStatus('No backups yet.', false);
            return;
        }

        backups.forEach(function (b) {
            var tr = document.createElement('tr');

            var tdName = document.createElement('td');
            tdName.textContent = b.name;
            tr.appendChild(tdName);

            var tdSize = document.createElement('td');
            tdSize.className = 'sc-col-backup-meta';
            tdSize.textContent = formatSize(b.size);
            tr.appendChild(tdSize);

            var tdCreated = document.createElement('td');
            tdCreated.className = 'sc-col-backup-meta';
            tdCreated.textContent = formatDate(b.created);
            tr.appendChild(tdCreated);

            var tdDelete = document.createElement('td');
            tdDelete.className = 'sc-col-backup-action';
            var deleteBtn = document.createElement('button');
            deleteBtn.type = 'button';
            deleteBtn.className = 'button';
            deleteBtn.innerHTML = '<i class="fa fa-trash"></i>';
            deleteBtn.title = 'Delete this backup';
            deleteBtn.dataset.name = b.name;
            tdDelete.appendChild(deleteBtn);
            tr.appendChild(tdDelete);

            backupsTbody.appendChild(tr);
        });

        backupsBox.style.display = '';
        setStatus(backups.length + ' backup(s).', false);
    }

    function loadBackups() {
        setStatus('Loading backups...', false);
        return post('ftpsynclistbackups').then(function (data) {
            if (data.status !== 'success') {
                setStatus('Error: ' + (data.message || 'unknown'), true);
                return;
            }
            renderBackups(data.backups || []);
        }).catch(function (e) {
            setStatus('Error: ' + e, true);
        });
    }

    showBackupsBtn.addEventListener('click', function () {
        if (backupsBox.style.display !== 'none') {
            backupsBox.style.display = 'none';
            return;
        }
        loadBackups();
    });

    var copyBackupPathBtn = document.getElementById('sc-copy-backup-path');
    if (copyBackupPathBtn) {
        copyBackupPathBtn.addEventListener('click', function () {
            var path = copyBackupPathBtn.dataset.path;
            navigator.clipboard.writeText(path).then(function () {
                setStatus('Path copied — paste it into File Explorer after your project folder.', false);
            }).catch(function () {
                setStatus('Could not copy automatically — path: ' + path, true);
            });
        });
    }

    backupsTbody.addEventListener('click', function (e) {
        var btn = e.target.closest('button[data-name]');
        if (!btn) { return; }

        var name = btn.dataset.name;
        if (!window.confirm('Delete backup "' + name + '"? This cannot be undone.')) {
            return;
        }

        setStatus('Deleting backup...', false);
        post('ftpsyncdeletebackup', [['name', name]]).then(function (data) {
            if (data.status !== 'success') {
                setStatus('Error: ' + (data.message || 'unknown'), true);
                return;
            }
            setStatus('Backup deleted.', false);
            loadBackups();
        }).catch(function (e) {
            setStatus('Error: ' + e, true);
        });
    });
})();
</script>
{% endif %}
{% endblock %}
